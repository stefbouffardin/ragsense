  <!-- ===== CUSTOM DEEP INTEGRATION ===== -->
  <section class="integrations-section">
    <div class="container">
      <div class="integrations-header">
        <h2>Custom deep integration</h2>
        <p>To allow your business to leverage the power of your data in real time, we have developed a set of deep integrations that go beyond standard connectors.</p>
      </div>
      <div class="integration-cards">
        <!-- Drupal card -->
        <div class="integration-card">
          <div class="integration-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </div>
          <!-- Drupal logo SVG -->
          <svg class="integration-icon" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
            <circle cx="30" cy="30" r="28" fill="#0678BE"/>
            <path d="M30 8c-2 4-6 6-10 8 4 2 8 6 8 12 0 5-3 9-8 11 2 0 4 1 6 1 8 0 14-6 14-13 0-8-6-15-10-19z" fill="white"/>
            <path d="M20 28c0-4 2-8 5-11-5 2-11 8-11 15 0 6 4 11 10 13-3-4-4-11-4-17z" fill="white" opacity="0.7"/>
          </svg>
          <h3>Drupal plugin</h3>
          <p>Automated content embedding and real-time synchronization directly from your Drupal CMS. New content is indexed as soon as it's published — no manual steps required.</p>
        </div>
        <!-- SharePoint card -->
        <div class="integration-card">
          <div class="integration-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7v10"/>
            </svg>
          </div>
          <!-- SharePoint logo SVG -->
          <svg class="integration-icon" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
            <circle cx="38" cy="22" r="14" fill="#036C70"/>
            <circle cx="26" cy="34" r="16" fill="#1A9BA1"/>
            <circle cx="18" cy="44" r="10" fill="#37C6D0"/>
            <rect x="14" y="34" width="32" height="20" rx="10" fill="#1A9BA1"/>
            <rect x="8" y="44" width="28" height="12" rx="6" fill="#37C6D0"/>
          </svg>
          <h3>SharePoint</h3>
          <p>Real-time indexing of your SharePoint Online libraries and document repositories. Permissions, metadata, and version history are fully respected during ingestion.</p>
        </div>
      </div>
