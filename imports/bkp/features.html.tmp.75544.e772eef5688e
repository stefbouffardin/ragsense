  <!-- ===== FEATURE 5: AI Agents (text left, screen right) ===== -->
  <section class="feature-row">
    <div class="container">
      <div class="feature-split">
        <div class="feature-text">
          <span class="feature-tag">AI Agents</span>
          <h2>Deploy AI agents tailored to your brand</h2>
          <p>Launch conversational AI agents designed for your specific use cases — customer service, internal helpdesk, sales enablement, or any custom workflow. No-code configuration, enterprise-grade reliability.</p>
          <p>Every agent is fully customizable: choose your LLM, define the tone of voice, restrict knowledge scope, and deploy in minutes across web, mobile, or API.</p>
        </div>
